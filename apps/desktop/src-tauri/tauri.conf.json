{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ADui Forge",
  "version": "1.4.1",
  "identifier": "com.aduistudio.forge",
  "build": {
    "devUrl": "http://localhost:5176",
    "frontendDist": "../../desktop-ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "ADui Forge",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "decorations": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "externalBin": ["binaries/forge-runner"],
    "targets": "all",
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "headerImage": "icons/nsis/headerImage.bmp",
        "sidebarImage": "icons/nsis/sidebarImage.bmp",
        "languages": ["SimpChinese", "English"]
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
