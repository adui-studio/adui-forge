generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// 一次 Agent Run 的持久化记录（REQUIREMENTS.md §50）
model Run {
  id         String    @id
  agentName  String
  task       String
  status     String
  createdAt  DateTime  @default(now())
  startedAt  DateTime?
  finishedAt DateTime?
  error      String?
  events     Json      @default("[]")

  @@index([createdAt])
  @@map("runs")
}

/// 平台用户（REQUIREMENTS.md §56）
model User {
  id           String   @id
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())

  @@map("users")
}

/// 任务台账（标题 → 派生 Run）
model Task {
  id        String   @id
  title     String
  runId     String
  status    String
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("tasks")
}

/// Workflow 定义（tasks 序列）
model Workflow {
  name        String   @id
  description String   @default("")
  tasks       Json
  createdAt   DateTime @default(now())

  @@map("workflows")
}
