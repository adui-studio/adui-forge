# 复制为 apps/api/.env（已被 .gitignore 排除）或注入 CI 环境

# PostgreSQL（infra/docker-compose.yml 提供开发实例）
DATABASE_URL=postgresql://forge:forge@localhost:5432/forge

# Redis（MVP-7 起使用）
REDIS_URL=redis://localhost:6379/0

# 模型配置（OpenAI Compatible；未配置时默认 Agent 不注册，Run 请求 404）
FORGE_MODEL_BASE_URL=
FORGE_MODEL_ID=
FORGE_MODEL_API_KEY=
FORGE_MODEL_NAME=

# Workspace 工具根目录
FORGE_WORKSPACE_ROOT=

# Sandbox：docker（默认隔离，无需信任模式）| host（仅 Trusted Local Mode）
FORGE_SANDBOX=docker
FORGE_SANDBOX_IMAGE=node:22-bookworm
FORGE_TRUSTED_LOCAL_MODE=0

# Agent Loop 上限
FORGE_AGENT_MAX_STEPS=16
FORGE_AGENT_TIMEOUT_MS=300000
FORGE_AGENT_TOKEN_LIMIT=
